{
	"name": "pi-deepseek-tools",
	"version": "0.1.0",
	"description": "DeepSeek web search and page fetch as Pi tools: live search with query operators, Markdown fetch with a local fallback, codemode-ready",
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi",
		"deepseek",
		"web-search",
		"search",
		"fetch",
		"agent"
	],
	"type": "module",
	"license": "MIT",
	"author": "Muntasim Ul Haque",
	"homepage": "https://github.com/muntasimulhaque/pi-deepseek-tools#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/muntasimulhaque/pi-deepseek-tools.git"
	},
	"bugs": {
		"url": "https://github.com/muntasimulhaque/pi-deepseek-tools/issues"
	},
	"files": [
		"index.ts",
		"deepseek.ts",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"scripts": {
		"typecheck": "tsc --noEmit"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"typebox": "^1.3.27"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*"
	},
	"devDependencies": {
		"@types/node": "^26.6.5",
		"typescript": "^7.0.2"
	}
}
